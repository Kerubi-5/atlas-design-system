{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm ci --prefix site",
  "buildCommand": "npm run build --prefix site",
  "outputDirectory": "site/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/playground", "destination": "/", "permanent": true },
    { "source": "/storybook", "destination": "/", "permanent": true },
    { "source": "/storybook/", "destination": "/", "permanent": true },
    {
      "source": "/tokens",
      "destination": "/?path=/story/foundations-tokens--theme",
      "permanent": true
    },
    {
      "source": "/docs/components",
      "destination": "/?path=/docs/docs-components--docs",
      "permanent": true
    },
    {
      "source": "/docs/design-rules",
      "destination": "/?path=/docs/docs-design-rules--docs",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/?path=/docs/docs-readme--docs",
      "permanent": true
    },
    {
      "source": "/docs/",
      "destination": "/?path=/docs/docs-readme--docs",
      "permanent": true
    },
    {
      "source": "/docs/readme",
      "destination": "/?path=/docs/docs-readme--docs",
      "permanent": true
    }
  ]
}
