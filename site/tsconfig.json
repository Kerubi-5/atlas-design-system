{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "paths": {
      "react": ["../node_modules/@types/react"],
      "react/*": ["../node_modules/@types/react/*"],
      "react-dom": ["../node_modules/@types/react-dom"],
      "react-dom/*": ["../node_modules/@types/react-dom/*"]
    },
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "vite.config.ts"
  ]
}
